{
  "$schema": "https://raw.githubusercontent.com/SimonCropp/MarkdownSnippets/main/schema.json",
  "Convention": "InPlaceOverwrite",
  "OmitSnippetLinks": true,
  "LinkFormat": "None",
  "ExcludeSnippetDirectories": ["node_modules", "bin", "obj", "dist", "artifacts"],
  "ExcludeMarkdownDirectories": ["site", "docs", "src", "tests", "bench", "artifacts", "skills", ".github", "checks", "scripts"]
}
