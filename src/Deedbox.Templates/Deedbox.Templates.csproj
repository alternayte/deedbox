<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>dotnet new templates for Deedbox: `dotnet new deedbox` makes a web app with one stream, an inline projection, schema setup, and decider and lockfile tests.</Description>
    <PackageType>Template</PackageType>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeContentInPack>true</IncludeContentInPack>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <IsAotCompatible>false</IsAotCompatible>
    <EnablePackageValidation>false</EnablePackageValidation>
    <IncludeSymbols>false</IncludeSymbols>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="content/**/*" Exclude="content/**/bin/**;content/**/obj/**;content/**/*.csproj" />
    <TemplateProject Include="content/**/*.csproj" Exclude="content/**/bin/**;content/**/obj/**" />
  </ItemGroup>

  <!-- The template's projects reference the Deedbox packages of this build: DEEDBOX_VERSION becomes the package version. -->
  <Target Name="StampTemplateProjects" BeforeTargets="_GetPackageFiles">
    <WriteLinesToFile
      File="$(IntermediateOutputPath)stamped/%(TemplateProject.RecursiveDir)%(TemplateProject.Filename)%(TemplateProject.Extension)"
      Lines="$([MSBuild]::Escape($([System.IO.File]::ReadAllText('%(TemplateProject.FullPath)').Replace('DEEDBOX_VERSION', '$(PackageVersion)'))))"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <None Include="$(IntermediateOutputPath)stamped/**/*.csproj" Pack="true" PackagePath="content/content/%(RecursiveDir)" />
    </ItemGroup>
  </Target>
</Project>
